# Kết nối MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# (Mật khẩu có ký tự đặc biệt như @ # : / cần mã hóa URL, VD: @ -> %40)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/gicungco"

# Khóa ký JWT — đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
# Địa chỉ Front-end được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGIN="http://localhost:5173"
